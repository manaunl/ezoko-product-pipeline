# A reference for every setting. The setup page writes these for you.
#
# The real file does NOT live here — it lives outside the app folder, so that
# updating the app cannot destroy your credentials:
#
#   ~/Library/Application Support/Ezoko/.env      (chmod 600)
#
# `npx tsx src/scripts/where.ts` prints the exact path on any machine.

# ---------------------------------------------------------------------------
# Shopify
# ---------------------------------------------------------------------------

# Your store domain, without https:// and without a trailing slash.
# Find it in Shopify admin -> Settings -> Domains ("myshopify.com domain").
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Client ID and secret from the Shopify Dev Dashboard:
#   dev.shopify.com/dashboard -> your app -> Settings / API credentials
#
# Since January 2026 Shopify no longer issues static "shpat_" tokens for new
# apps. Instead the tool exchanges these two values for a 24-hour access token
# and refreshes it automatically. The app and the store must belong to the same
# Shopify organization for this to work.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only for stores with a legacy custom app created before January 2026, which
# still have a permanent token. If set, it is used instead of the two values
# above. The owner's live store may well have one of these.
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------

# OAuth client credentials from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID -> Desktop app).
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# The spreadsheet ID, taken from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# The name of the tab within the spreadsheet (not the file name).
GOOGLE_SHEET_TAB=Sheet1

# The Drive folder holding the photos, taken from its URL:
# https://drive.google.com/drive/folders/THIS_PART_HERE
GOOGLE_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Where product descriptions come from
# ---------------------------------------------------------------------------

# Each new product copies its description from the products already published
# for that stone, read from this shop's public /products.json feed. No
# credentials are involved — it is the same data any visitor can see.
#
# INCLUDE THE LANGUAGE. The address without /en serves the Hungarian pages,
# whose headings say "Szerpentin" rather than "Serpentine", so every lookup
# would miss. The tool checks for this and refuses to run rather than creating
# products with empty descriptions.
EZOKO_STOREFRONT_URL=https://ezoko.shop/en

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port for the local web page. Only listens on 127.0.0.1.
PORT=4517
